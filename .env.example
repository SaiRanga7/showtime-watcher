# Copy to .env to run on your own machine. On GitHub these are repository *secrets*.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NTFY_TOPIC=

# Optional
# EMAIL_TO=                 # defaults to GMAIL_ADDRESS
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=               # only for a password-protected ntfy server
# DAILY_HOUR=9              # IST hour after which the daily check-in is sent
# DAILY_MESSAGE=true        # false = no daily Telegram message (keep-alive still happens)
# BLIND_AFTER_MINUTES=45    # alert if every check has failed for this long
